DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=blood_bank_db
DB_PORT=3306
# Required. Signs login tokens - use a long random string and keep it secret
JWT_SECRET=your_jwt_secret_key_here
PORT=5000

# Email - sends the one-time sign up / login / reset codes. Set up ONE of these two.
# If neither is set, codes are printed in the server console (local development only).

# Option 1: Gmail - can email any address, no domain needed.
# Needs 2-Step Verification on the Google account, then an app password from
# https://myaccount.google.com/apppasswords (16 letters; spaces are fine).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Option 2: Resend - used when the Gmail settings are empty
RESEND_API_KEY=re_your_resend_api_key
# "onboarding@resend.dev" only delivers to the email you registered Resend with.
# To email anyone, verify a domain at resend.com/domains and use an address on it.
MAIL_FROM=Blood Bank <onboarding@resend.dev>
# Optional: separate secret for hashing codes (falls back to JWT_SECRET)
# OTP_SECRET=
