DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=blood_bank_db
DB_PORT=3306
# Required. Signs login tokens - use a long random string and keep it secret
JWT_SECRET=your_jwt_secret_key_here
PORT=5000

# Optional: encrypts the authenticator app secrets saved in the database (falls back to JWT_SECRET).
# Changing it later breaks every existing authenticator - staff would have to reset them all.
# MFA_SECRET=
